# Team Car as a systemd service. Example setup (Debian/Ubuntu):
#
#   sudo useradd --system --create-home --home-dir /var/lib/teamcar --shell /bin/bash teamcar
#   sudo install -m 0755 teamcar /usr/local/bin/teamcar
#   sudo cp teamcar.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now teamcar
#   journalctl -u teamcar -f
#
# Log the teamcar user in to claude, codex and gh once (see README, "Run on a server").

[Unit]
Description=Team Car (Domestique server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=teamcar
Group=teamcar
# Database, socket and teamcar.toml. Repositories and worktrees default to ~/Domestique/.
Environment=TEAMCAR_HOME=/var/lib/teamcar/teamcar
# Where the agent CLIs usually land (claude's installer uses ~/.local/bin).
Environment=PATH=/var/lib/teamcar/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=~
# Bind to a private address (Tailscale, WireGuard) or 127.0.0.1 behind a TLS proxy rather than
# 0.0.0.0 unless something in front encrypts the traffic. See README.
ExecStart=/usr/local/bin/teamcar serve --listen unix:///var/lib/teamcar/teamcar/teamcar.sock --listen tcp://0.0.0.0:7420
Restart=on-failure
RestartSec=2
# SIGTERM to Team Car first so it stops its agents cleanly; the rest of the cgroup (processes
# clients started) is killed after the timeout.
KillMode=mixed
TimeoutStopSec=20
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
